# Use Supabase "Session pooler" (NOT Direct connection).
# Direct db.*.supabase.co is IPv6-only and often times out on home/Wi‑Fi networks.
#
# Supabase → Project Settings → Database → Connection string → URI
# Method: Session pooler (port 5432, host like aws-0-….pooler.supabase.com)
# Username must look like: postgres.<project-ref>
#
# Example:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Set to false only for local Postgres without SSL
# DATABASE_SSL=false

PORT=8000
